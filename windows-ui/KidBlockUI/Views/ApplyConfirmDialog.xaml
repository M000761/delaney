<Window x:Class="KidBlockUI.Views.ApplyConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply changes?"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Foreground="#DDDDDD"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PaneBg"       Color="#252526"/>
        <SolidColorBrush x:Key="PaneHeaderBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#3F3F46"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PaneHeaderBg}" Padding="12,8"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14"/>
        </Border>

        <ListBox x:Name="DiffList" Grid.Row="1"
                 Background="{StaticResource PaneBg}" Foreground="#DDDDDD"
                 BorderThickness="0" Padding="6"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Width="22"
                                       FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{Binding Color}"/>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas"
                                       Foreground="{Binding Color}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{StaticResource PaneHeaderBg}" Padding="12,8"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel"
                        Padding="18,4" Margin="0,0,8,0"
                        IsCancel="True" Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" Content="Apply"
                        Padding="18,4"
                        IsDefault="True" Click="ConfirmButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
