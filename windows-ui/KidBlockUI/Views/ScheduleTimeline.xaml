<UserControl x:Class="KidBlockUI.Views.ScheduleTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             MinHeight="120">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#163B16"
                BorderBrush="#3F3F46" BorderThickness="1"
                ClipToBounds="True">
            <Canvas x:Name="TimelineCanvas"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                    SizeChanged="TimelineCanvas_SizeChanged"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
        </Border>

        <Canvas Grid.Row="1" x:Name="HourAxis"
                Background="#1E1E1E"
                ClipToBounds="True"
                SizeChanged="HourAxis_SizeChanged"/>
    </Grid>
</UserControl>
