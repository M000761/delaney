<UserControl x:Class="KidBlockUI.Views.DomainsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KidBlockUI.ViewModels"
             Background="#252526" Foreground="#DDDDDD"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PaneHeaderBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#3F3F46"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PaneHeaderBg}" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Blocked domains" FontWeight="SemiBold"/>
                <Border Grid.Column="1"
                        Background="#553311" CornerRadius="3" Padding="6,1"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <Run Text="● "/>
                        <Run Text="{Binding PendingChangeCount, Mode=OneWay}"/>
                        <Run Text=" pending"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,6"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Discard" Padding="14,4" Margin="0,0,8,0"
                            Click="DiscardDomains_Click" IsEnabled="{Binding HasPendingChanges}"/>
                    <Button Content="Apply" Padding="14,4"
                            Click="ApplyDomains_Click" IsEnabled="{Binding HasPendingChanges}"/>
                </StackPanel>
                <TextBlock Text="{Binding ApplyError}" Foreground="#FF8080"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                            <Expander Margin="4,2" Foreground="#DDDDDD" Background="Transparent">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsThreeState="True"
                                                  IsChecked="{Binding HeaderChecked, Mode=OneWay}"
                                                  Click="CategoryToggle_Click"
                                                  Tag="{Binding}"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Domains}" Margin="22,4,4,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DomainCheckboxViewModel}">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Content="{Binding Domain}" ToolTip="{Binding Tooltip}"
                                                      FontFamily="Consolas" Padding="4,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Margin="4,8,4,2" Foreground="#DDDDDD" Background="Transparent" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="Other ("/>
                            <Run Text="{Binding OtherDomains.Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="22,4,4,8">
                        <ItemsControl ItemsSource="{Binding OtherDomains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DomainCheckboxViewModel}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Domain}"
                                                   FontFamily="Consolas" Padding="4,1"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Not in any category (manually added or pre-existing)"/>
                                        <Button Grid.Column="1" Content="Remove" Padding="8,1" Margin="6,0,0,0"
                                                Click="RemoveOther_Click" Tag="{Binding Domain}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewOtherDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" Padding="4,2"
                                     KeyDown="NewOtherBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Add" Padding="10,2" Margin="6,0,0,0"
                                    Click="AddOther_Click"/>
                        </Grid>
                        <TextBlock Text="{Binding AddOtherError}" Foreground="#FF8080" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AddOtherError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
