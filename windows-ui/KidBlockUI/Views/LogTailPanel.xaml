<UserControl x:Class="KidBlockUI.Views.LogTailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:KidBlockUI.Views"
             Background="{StaticResource LogSurfaceBg}"
             Foreground="{StaticResource TextPrimary}"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- DM15: chrome brushes (PaneHeaderBg / BorderSubtle / MutedText) moved to
             Themes/Theme.xaml; the LogKind dot colours below resolve from there too. -->
        <v:LogKindToBrushConverter      x:Key="KindBrush"/>
        <v:SearchHighlightConverter     x:Key="HighlightBrush"/>
        <v:LogKindToFontWeightConverter x:Key="KindFontWeight"/>
        <BooleanToVisibilityConverter   x:Key="BoolToVis"/>

        <Style x:Key="FilterCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top" Background="{StaticResource PaneHeaderBg}" Padding="10,4"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Header label + per; Kind filter checkboxes -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Live log" FontWeight="SemiBold" Margin="0,0,14,0"
                               VerticalAlignment="Center"/>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowBlock}"
                              ToolTip="Block events (a block window started or KILL fired)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindBlock}"/>
                            <TextBlock Text="Block"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowAllow}"
                              ToolTip="Allow events (a block window ended or override granted)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindAllow}"/>
                            <TextBlock Text="Allow"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowOverride}"
                              ToolTip="Override events (manual block; allow with duration)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindOverride}"/>
                            <TextBlock Text="Override"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowScheduleTick}"
                              ToolTip="Schedule tick (state transitioned at a schedule boundary)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindTick}"/>
                            <TextBlock Text="Tick"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowInstall}"
                              ToolTip="Domain blocklist install / uninstall">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindInstall}"/>
                            <TextBlock Text="Install"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowError}"
                              ToolTip="Lines that failed to parse the kidblock.sh log format">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindError}"/>
                            <TextBlock Text="Error"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowOther}"
                              ToolTip="Lines that parsed but did not match a known message family">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindOther}"/>
                            <TextBlock Text="Other"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding ShowDns}"
                              ToolTip="DM10 spike: dnsmasq queries; high volume; default OFF">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,4,0" Fill="{StaticResource LogKindDns}"/>
                            <TextBlock Text="DNS"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

                <!-- Spacer; right-side controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" Margin="0,0,4,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedText}"/>
                    <TextBox x:Name="SearchBox" Width="140" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PaneBg}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderSubtle}"
                             VerticalContentAlignment="Center"
                             Padding="4,1"/>
                    <CheckBox Style="{StaticResource FilterCheck}" IsChecked="{Binding AutoScroll}"
                              ToolTip="Auto; scroll to newest entry as events arrive">
                        <TextBlock Text="Auto-scroll"/>
                    </CheckBox>
                    <Button Content="Clear" Padding="10,2" Margin="4,0,0,0"
                            Command="{Binding ClearCommand}"
                            ToolTip="Clear the visible log; the live stream continues"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DM22: per-MAC filter chip. Shown only when a MAC filter is active (right-click
             a Devices row -> "Filter log to this MAC"); the x clears it. PendingBadgeBg
             chrome; no inline hex, so PaletteLint stays green. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PaneBg}" Padding="10,3"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasMacFilter, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource PendingBadgeBg}" CornerRadius="3" Padding="8,2"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter: " Foreground="{StaticResource TextPrimary}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FilterMacLabel}" Foreground="{StaticResource TextPrimary}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="x" Command="{Binding ClearMacFilterCommand}"
                            Margin="8,0,0,0" Padding="6,0" FontSize="11" FontWeight="Bold"
                            Background="Transparent" Foreground="{StaticResource TextPrimary}"
                            BorderThickness="0" Cursor="Hand"
                            ToolTip="Clear the per-MAC log filter"/>
                </StackPanel>
            </Border>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PaneBg}" Padding="10,2"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedText}"
                       FontSize="11" FontStyle="Italic"/>
        </Border>

        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource LogSurfaceBg}">
            <ItemsControl ItemsSource="{Binding View}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,1">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource HighlightBrush}">
                                    <Binding Path="Message"/>
                                    <Binding Path="DataContext.SearchText"
                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                </MultiBinding>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Kind, Converter={StaticResource KindBrush}}"/>
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"
                                           FontWeight="{Binding Kind, Converter={StaticResource KindFontWeight}}"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
