<Window x:Class="KidBlockUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        xmlns:v="clr-namespace:KidBlockUI.Views"
        xmlns:r="clr-namespace:KidBlockUI.Resources"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=FluentDark}"
        Title="KidBlock"
        Height="780" Width="1180"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing">
    <Window.Resources>
        <!-- DM16 (DM13 program, Stage 2): MainWindow rebuilt as a Syncfusion Ribbon shell.
             The bespoke controls (Devices grid, ScheduleTimeline, DomainsControl, LogTailPanel)
             are HOSTED in the shell body unchanged; the command surface (Refresh, router-wide
             bulk, per-device actions, the DM11 allow-duration popup) moves onto the six static
             RibbonTabs as RibbonBar groups. Chrome brushes resolve app-wide from Themes/Theme.xaml
             (DM15); no inline hex here, so the PaletteLint guard stays green. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <v:InvertBoolConverter        x:Key="InvertBool"/>

        <!-- Ribbon button glyphs: Segoe UI Emoji char-entities (ASCII-only source; render as
             monochrome line-glyphs under FluentDark). A Viewbox scales each to the SizeForm slot. -->
        <DataTemplate x:Key="IcoRefresh"> <Viewbox Stretch="Uniform"><TextBlock Text="&#x1F504;" FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoKill">    <Viewbox Stretch="Uniform"><TextBlock Text="&#x1F6D1;" FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoAllow">   <Viewbox Stretch="Uniform"><TextBlock Text="&#x2705;"  FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoClear">   <Viewbox Stretch="Uniform"><TextBlock Text="&#x1F9F9;" FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoMode">    <Viewbox Stretch="Uniform"><TextBlock Text="&#x1F500;" FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoApply">   <Viewbox Stretch="Uniform"><TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoDiscard"> <Viewbox Stretch="Uniform"><TextBlock Text="&#x21A9;"  FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoLogClear"><Viewbox Stretch="Uniform"><TextBlock Text="&#x1F5D1;" FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
        <DataTemplate x:Key="IcoLayout">  <Viewbox Stretch="Uniform"><TextBlock Text="&#x25A6;"  FontFamily="Segoe UI Emoji" FontSize="16"/></Viewbox></DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- =========================== TIER 1 + 2: the Ribbon ===========================
             Six STATIC RibbonTabs (Home / Devices / Schedule / Domains / Log / View); NO
             ContextTabGroups. RibbonState=Adorner (Office "Show Tabs" per BM360); the band
             collapses to a tab strip and drops down on a tab click. FluentDark themes it via
             SfSkinManager (DM14 ApplyThemeAsDefaultStyle plus the window Theme above). -->
        <syncfusion:Ribbon x:Name="Ribbon"
                           DockPanel.Dock="Top"
                           RibbonState="Adorner"
                           MinimizeButtonVisibility="Visible"
                           ShowCustomizeRibbon="False">

            <!-- =================== HOME : connection + router-wide override =================== -->
            <syncfusion:RibbonTab x:Name="HomeTab" Caption="Home">
                <syncfusion:RibbonBar Header="Connection">
                    <syncfusion:RibbonButton x:Name="RefreshButton"
                                             Label="Refresh"
                                             SizeForm="Large"
                                             Command="{Binding RefreshCommand}"
                                             IconTemplate="{StaticResource IcoRefresh}"
                                             ToolTip="Refresh the device / schedule / override state from the router."/>
                </syncfusion:RibbonBar>
                <syncfusion:RibbonBar Header="Router-wide override">
                    <syncfusion:RibbonButton x:Name="KillAllButton"
                                             Label="KILL ALL"
                                             SizeForm="Large"
                                             Command="{Binding BulkKillCommand}"
                                             IconTemplate="{StaticResource IcoKill}"
                                             ToolTip="Block ALL controlled devices for up to 24h (confirm-gated, bedtime use case)."/>
                    <syncfusion:RibbonButton x:Name="AllowAllButton"
                                             Label="Allow 30m"
                                             SizeForm="Small"
                                             Command="{Binding BulkAllowCommand}"
                                             IconTemplate="{StaticResource IcoAllow}"
                                             ToolTip="Allow ALL controlled devices online for 30 minutes (router-wide override)."/>
                    <ToggleButton x:Name="BulkAllowSplit"
                                  Content="&#x25BC;"
                                  FontSize="9" Padding="6,2" Margin="0,2"
                                  VerticalAlignment="Center"
                                  ToolTip="Pick an allow duration for ALL devices: 15m / 30m / 45m / 1h to 8h."/>
                    <Popup PlacementTarget="{Binding ElementName=BulkAllowSplit}" Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=BulkAllowSplit, Mode=TwoWay}"
                           StaysOpen="False">
                        <Border Background="{StaticResource PaneHeaderBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <ItemsControl ItemsSource="{x:Static r:AllowDurations.Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                CommandParameter="{Binding Minutes}"
                                                Command="{Binding DataContext.BulkAllowDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                Click="AllowDurationItem_Click"
                                                Foreground="White"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,5" MinWidth="130"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                    <syncfusion:RibbonButton x:Name="ClearAllButton"
                                             Label="CLEAR ALL"
                                             SizeForm="Small"
                                             Command="{Binding BulkClearCommand}"
                                             IconTemplate="{StaticResource IcoClear}"
                                             ToolTip="Clear all active per-MAC overrides; every device returns to the schedule."/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>

            <!-- =================== DEVICES : selected-device actions =================== -->
            <syncfusion:RibbonTab x:Name="DevicesTab" Caption="Devices">
                <syncfusion:RibbonBar Header="Selected device">
                    <syncfusion:RibbonButton x:Name="DeviceKillButton"
                                             Label="KILL"
                                             SizeForm="Large"
                                             Command="{Binding SelectedDevice.KillCommand}"
                                             IsEnabled="{Binding SelectedDevice.IsBusy, Converter={StaticResource InvertBool}, FallbackValue=False}"
                                             IconTemplate="{StaticResource IcoKill}"
                                             ToolTip="Block the selected device for up to 24h (this device only; clear to release sooner)."/>
                    <syncfusion:RibbonButton x:Name="DeviceAllowButton"
                                             Label="Allow 30m"
                                             SizeForm="Small"
                                             Command="{Binding SelectedDevice.Allow30mCommand}"
                                             IsEnabled="{Binding SelectedDevice.IsBusy, Converter={StaticResource InvertBool}, FallbackValue=False}"
                                             IconTemplate="{StaticResource IcoAllow}"
                                             ToolTip="Allow the selected device internet access for 30 minutes (this device only)."/>
                    <ToggleButton x:Name="DeviceAllowSplit"
                                  Content="&#x25BC;"
                                  FontSize="9" Padding="6,2" Margin="0,2"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding SelectedDevice.IsBusy, Converter={StaticResource InvertBool}, FallbackValue=False}"
                                  ToolTip="Pick an allow duration for the selected device: 15m / 30m / 45m / 1h to 8h."/>
                    <Popup PlacementTarget="{Binding ElementName=DeviceAllowSplit}" Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=DeviceAllowSplit, Mode=TwoWay}"
                           StaysOpen="False">
                        <Border Background="{StaticResource PaneHeaderBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <ItemsControl ItemsSource="{x:Static r:AllowDurations.Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                CommandParameter="{Binding Minutes}"
                                                Command="{Binding DataContext.SelectedDevice.AllowDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                Click="AllowDurationItem_Click"
                                                Foreground="White"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,5" MinWidth="110"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                    <syncfusion:RibbonButton x:Name="DeviceClearButton"
                                             Label="Clear"
                                             SizeForm="Small"
                                             Command="{Binding SelectedDevice.ClearOverrideCommand}"
                                             IsEnabled="{Binding SelectedDevice.IsBusy, Converter={StaticResource InvertBool}, FallbackValue=False}"
                                             IconTemplate="{StaticResource IcoClear}"
                                             ToolTip="Clear the selected device's override (return it to the schedule)."/>
                    <syncfusion:RibbonButton x:Name="DeviceModeButton"
                                             Label="Toggle Mode"
                                             SizeForm="Small"
                                             Command="{Binding SelectedDevice.ToggleModeCommand}"
                                             IsEnabled="{Binding SelectedDevice.IsBusy, Converter={StaticResource InvertBool}, FallbackValue=False}"
                                             IconTemplate="{StaticResource IcoMode}"
                                             ToolTip="Toggle the selected device between Blocklist and Whitelist mode."/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>

            <!-- =================== SCHEDULE : pending-change apply =================== -->
            <syncfusion:RibbonTab x:Name="ScheduleTab" Caption="Schedule">
                <syncfusion:RibbonBar Header="Pending changes">
                    <syncfusion:RibbonButton x:Name="ScheduleApplyButton"
                                             Label="Apply"
                                             SizeForm="Large"
                                             Click="ApplySchedule_Click"
                                             IsEnabled="{Binding Schedule.HasPendingChanges}"
                                             IconTemplate="{StaticResource IcoApply}"
                                             ToolTip="Apply the staged schedule changes to the router (confirm-gated)."/>
                    <syncfusion:RibbonButton x:Name="ScheduleDiscardButton"
                                             Label="Discard"
                                             SizeForm="Small"
                                             Click="DiscardSchedule_Click"
                                             IsEnabled="{Binding Schedule.HasPendingChanges}"
                                             IconTemplate="{StaticResource IcoDiscard}"
                                             ToolTip="Discard the staged schedule changes."/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>

            <!-- =================== DOMAINS : pending-change apply =================== -->
            <syncfusion:RibbonTab x:Name="DomainsTab" Caption="Domains">
                <syncfusion:RibbonBar Header="Pending changes">
                    <syncfusion:RibbonButton x:Name="DomainsApplyButton"
                                             Label="Apply"
                                             SizeForm="Large"
                                             Click="ApplyDomains_Click"
                                             IsEnabled="{Binding Domains.HasPendingChanges}"
                                             IconTemplate="{StaticResource IcoApply}"
                                             ToolTip="Apply the staged domain (blocklist / allowlist) changes to the router (confirm-gated)."/>
                    <syncfusion:RibbonButton x:Name="DomainsDiscardButton"
                                             Label="Discard"
                                             SizeForm="Small"
                                             Click="DiscardDomains_Click"
                                             IsEnabled="{Binding Domains.HasPendingChanges}"
                                             IconTemplate="{StaticResource IcoDiscard}"
                                             ToolTip="Discard the staged domain changes."/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>

            <!-- =================== LOG : live-log action =================== -->
            <syncfusion:RibbonTab x:Name="LogTab" Caption="Log">
                <syncfusion:RibbonBar Header="Live log">
                    <syncfusion:RibbonButton x:Name="LogClearButton"
                                             Label="Clear"
                                             SizeForm="Large"
                                             Command="{Binding LogTail.ClearCommand}"
                                             IconTemplate="{StaticResource IcoLogClear}"
                                             ToolTip="Clear the live-log strip (does not touch the router log)."/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>

            <!-- =================== VIEW : live-log display preferences + layout ===================
                 Lean by design: KidBlock's panes self-contain their controls, so View
                 surfaces the display preferences (mirrors of LogTail state) plus the DM17
                 DockingManager layout commands (the Layout group below). -->
            <syncfusion:RibbonTab x:Name="ViewTab" Caption="View">
                <syncfusion:RibbonBar Header="Live log display">
                    <CheckBox x:Name="AutoScrollCheck"
                              Content="Auto-scroll"
                              IsChecked="{Binding LogTail.AutoScroll, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="6,2"
                              ToolTip="Keep the live-log strip scrolled to the newest entry."/>
                    <CheckBox x:Name="ShowDnsCheck"
                              Content="Show DNS"
                              IsChecked="{Binding LogTail.ShowDns, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="6,2"
                              ToolTip="Surface the dnsmasq DNS-query firehose in the live log (off by default)."/>
                </syncfusion:RibbonBar>
                <!-- DM17 (DM13 program, Stage 3): layout commands for the DockingManager body.
                     Reset returns the four panes to their default docked arrangement, recovering
                     from any float / auto-hide / resize the user made; the persisted layout is
                     rewritten on the next close. -->
                <syncfusion:RibbonBar Header="Layout">
                    <syncfusion:RibbonButton x:Name="ResetLayoutButton"
                                             Label="Reset Layout"
                                             SizeForm="Large"
                                             Click="ResetLayout_Click"
                                             IconTemplate="{StaticResource IcoLayout}"
                                             ToolTip="Return the Devices / Schedule / Domains / Live log panes to their default docked arrangement."/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>

        </syncfusion:Ribbon>

        <!-- =========================== Status bar (bottom) ===========================
             Consolidates the old top-strip connection indicators (dot + router label +
             error) with the bottom status label and the BulkActionBar overrides summary,
             now that those command surfaces moved onto the Ribbon. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PaneHeaderBg}" Padding="10,4"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ConnDot" Grid.Column="0"
                         Width="12" Height="12" Margin="0,0,8,0"
                         Fill="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding RouterLabel}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" Text="{Binding OverridesSummary}"
                           Foreground="{StaticResource StatusWarn}" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                           Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource StatusErr}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- =========================== Body : DockingManager (DM17) ===========================
             DM17 (DM13 program, Stage 3, optional): the static 4-pane Grid becomes a Syncfusion
             DockingManager so each bespoke pane (Devices / Schedule / Domains / Live log) is a
             dockable, tear-off / floatable child whose arrangement persists across runs
             (SaveDockState on close, LoadDockState on open; code-behind). PersistState=False so we
             own the save / load points, mirroring boat's DockShellView. UseDocumentContainer=True
             hosts Schedule as the centre document; Devices docks top, Domains right, Live log
             bottom, approximating the prior Grid. CanClose=False on every pane: there is no re-add
             UI, so a pane must never be closable to nothing (the View tab Reset Layout button
             restores the default arrangement). All chrome resolves Theme.xaml tokens; no inline
             hex, so PaletteLint stays green. -->
        <syncfusion:DockingManager x:Name="Docker"
                                   UseDocumentContainer="True"
                                   PersistState="False">

            <!-- Devices: native DataGrid hosted unchanged (rich per-row templates: mode toggle,
                 override badge, the per-device action buttons plus the DM11 allow-duration
                 split-popup, the last-action toast). The DockingManager caption carries the title,
                 so the old in-pane header strip is dropped. -->
            <Border x:Name="DevicesPane"
                    syncfusion:DockingManager.Header="Devices"
                    syncfusion:DockingManager.State="Dock"
                    syncfusion:DockingManager.SideInDockedMode="Top"
                    syncfusion:DockingManager.DesiredHeightInDockedMode="240"
                    syncfusion:DockingManager.CanClose="False"
                    Background="{StaticResource PaneBg}">
                <DockPanel>
                    <DataGrid ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              SelectionMode="Single"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              Foreground="{StaticResource TextPrimary}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{StaticResource RowAltBg}"
                              HorizontalGridLinesBrush="{StaticResource BorderSubtle}"
                              BorderThickness="0"
                              RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"       Binding="{Binding Name}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="MAC"        Binding="{Binding Mac}"  Width="Auto" MinWidth="150"/>
                            <DataGridTextColumn Header="IP"         Binding="{Binding Ip}"   Width="Auto" MinWidth="120"/>
                            <DataGridTemplateColumn Header="Mode" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ModeLabel}"
                                                Command="{Binding ToggleModeCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                FontFamily="Consolas" FontSize="11"
                                                FontWeight="SemiBold" Foreground="White"
                                                Padding="10,3" Margin="4,8"
                                                BorderThickness="1"
                                                ToolTip="Click to toggle this device between Blocklist and Whitelist mode. Writes kidblock-macs.conf + runs reapply.">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background"  Value="{StaticResource BtnModeBlocklistBg}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BtnModeBlocklistBorder}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWhitelist}" Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource BtnModeWhitelistBg}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource BtnModeWhitelistBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Override" Width="Auto" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding OverrideBadgeBackground}"
                                                CornerRadius="3" Padding="6,2" Margin="4,6"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OverrideBadgeText}"
                                                       Foreground="White"
                                                       FontFamily="Consolas" FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,4,2,2">
                                                <Button Content="KILL"
                                                        Command="{Binding KillCommand}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                        Background="{StaticResource BtnDangerBg}" Foreground="White"
                                                        FontWeight="Bold" FontSize="13"
                                                        Padding="14,4" Margin="0,0,4,0"
                                                        BorderBrush="{StaticResource BtnDangerBorder}" BorderThickness="1"
                                                        ToolTip="{Binding KillTooltip}"/>
                                                <Grid Margin="0,0,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="Allow 30m"
                                                            Command="{Binding Allow30mCommand}"
                                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                            Background="{StaticResource BtnAllowBg}" Foreground="White"
                                                            Padding="10,4"
                                                            BorderBrush="{StaticResource BtnAllowBorder}" BorderThickness="1,1,0,1"
                                                            ToolTip="{Binding AllowTooltip}"/>
                                                    <ToggleButton Grid.Column="1" x:Name="AllowSplit"
                                                                  Content="&#x25BC;"
                                                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                                  Background="{StaticResource BtnAllowSplitBg}" Foreground="White"
                                                                  FontSize="9" Padding="6,4"
                                                                  BorderBrush="{StaticResource BtnAllowBorder}" BorderThickness="0,1,1,1"
                                                                  ToolTip="Pick an allow duration: 15m / 30m / 45m / 1h to 8h"/>
                                                    <Popup PlacementTarget="{Binding ElementName=AllowSplit}" Placement="Bottom"
                                                           IsOpen="{Binding IsChecked, ElementName=AllowSplit, Mode=TwoWay}"
                                                           StaysOpen="False">
                                                        <Border Background="{StaticResource PaneHeaderBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                                            <ItemsControl ItemsSource="{x:Static r:AllowDurations.Presets}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Label}"
                                                                                CommandParameter="{Binding Minutes}"
                                                                                Command="{Binding DataContext.AllowDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                                Click="AllowDurationItem_Click"
                                                                                Foreground="White"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                HorizontalContentAlignment="Left"
                                                                                Padding="14,5" MinWidth="110"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                <Button Content="Clear"
                                                        Command="{Binding ClearOverrideCommand}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                        Background="{StaticResource BtnNeutralBg}" Foreground="White"
                                                        Padding="10,4"
                                                        BorderBrush="{StaticResource BtnNeutralBorder}" BorderThickness="1"
                                                        ToolTip="{Binding ClearTooltip}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Margin="4,0,0,2"
                                                       Text="{Binding LastActionText}"
                                                       Foreground="{StaticResource StatusWarn}"
                                                       FontSize="10"
                                                       FontStyle="Italic">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastActionText}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1" To="0" Duration="0:0:0.6"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             To="1" Duration="0:0:0.15"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last DHCP"  Binding="{Binding LastDhcp, StringFormat='yyyy-MM-dd HH:mm'}" Width="*" MinWidth="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Schedule: ScheduleTimeline hosted unchanged. Apply / Discard are kept in the
                 pane footer AND mirrored on the Schedule ribbon tab (both call the same
                 ApplySchedule_Click / DiscardSchedule_Click handlers). -->
            <Border x:Name="SchedulePane"
                    syncfusion:DockingManager.Header="Schedule"
                    syncfusion:DockingManager.State="Document"
                    syncfusion:DockingManager.CanClose="False"
                    Background="{StaticResource PaneBg}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PaneHeaderBg}" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Schedule (block windows)" FontWeight="SemiBold"/>
                            <Border Grid.Column="1"
                                    Background="{StaticResource PendingBadgeBg}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Visibility="{Binding Schedule.HasPendingChanges, Converter={StaticResource BoolToVis}}">
                                <TextBlock>
                                    <Run Text="&#x25CF; "/>
                                    <Run Text="{Binding Schedule.PendingChangeCount, Mode=OneWay}"/>
                                    <Run Text=" pending"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="10,6"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Discard"
                                        Padding="14,4" Margin="0,0,8,0"
                                        Click="DiscardSchedule_Click"
                                        IsEnabled="{Binding Schedule.HasPendingChanges}"/>
                                <Button Content="Apply"
                                        Padding="14,4"
                                        Click="ApplySchedule_Click"
                                        IsEnabled="{Binding Schedule.HasPendingChanges}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Schedule.ApplyError}"
                                       Foreground="{StaticResource StatusErr}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <v:ScheduleTimeline x:Name="Timeline"
                                        EditedSchedule="{Binding Schedule.EditedSchedule}"
                                        OverrideActive="{Binding Schedule.OverrideActive}"
                                        Margin="6"/>
                </DockPanel>
            </Border>

            <!-- Domains: DomainsControl hosted unchanged (self-contains its own Apply / Discard,
                 mirrored on the Domains ribbon tab), docked right. -->
            <Border x:Name="DomainsPane"
                    syncfusion:DockingManager.Header="Domains"
                    syncfusion:DockingManager.State="Dock"
                    syncfusion:DockingManager.SideInDockedMode="Right"
                    syncfusion:DockingManager.DesiredWidthInDockedMode="300"
                    syncfusion:DockingManager.CanClose="False"
                    Background="{StaticResource PaneBg}">
                <v:DomainsControl DataContext="{Binding Domains}"/>
            </Border>

            <!-- Live log: LogTailPanel hosted unchanged, docked bottom (full width). -->
            <v:LogTailPanel x:Name="LogPane"
                            syncfusion:DockingManager.Header="Live Log"
                            syncfusion:DockingManager.State="Dock"
                            syncfusion:DockingManager.SideInDockedMode="Bottom"
                            syncfusion:DockingManager.DesiredHeightInDockedMode="220"
                            syncfusion:DockingManager.CanClose="False"
                            DataContext="{Binding LogTail}"/>
        </syncfusion:DockingManager>
    </DockPanel>
</Window>
