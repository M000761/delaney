<Window x:Class="KidBlockUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:KidBlockUI.Views"
        Title="KidBlock"
        Height="640" Width="1180"
        Background="#1E1E1E"
        Foreground="#DDDDDD"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PaneBg"        Color="#252526"/>
        <SolidColorBrush x:Key="PaneHeaderBg"  Color="#2D2D30"/>
        <SolidColorBrush x:Key="BorderSubtle"  Color="#3F3F46"/>
        <SolidColorBrush x:Key="MutedText"     Color="#AAAAAA"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <v:InvertBoolConverter        x:Key="InvertBool"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PaneHeaderBg}" Padding="10,6"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ConnDot" Grid.Column="0"
                         Width="14" Height="14" Margin="0,0,10,0"
                         Fill="Gray" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding RouterLabel}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="{Binding ErrorMessage}"
                           VerticalAlignment="Center" Margin="6,0,12,0"
                           Foreground="#FF8080" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="3" Content="Refresh"
                        Padding="14,4"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PaneBg}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PaneHeaderBg}" Padding="10,4">
                        <TextBlock Text="Devices" FontWeight="SemiBold"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Devices}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              Foreground="#DDDDDD"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#2A2A2E"
                              HorizontalGridLinesBrush="{StaticResource BorderSubtle}"
                              BorderThickness="0"
                              RowHeight="48">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"       Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="MAC"        Binding="{Binding Mac}"  Width="Auto"/>
                            <DataGridTextColumn Header="IP"         Binding="{Binding Ip}" Width="120"/>
                            <DataGridTemplateColumn Header="Override" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding OverrideBadgeBackground}"
                                                CornerRadius="3" Padding="6,2" Margin="4,6"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OverrideBadgeText}"
                                                       Foreground="White"
                                                       FontFamily="Consolas" FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,4,2,2">
                                                <Button Content="KILL"
                                                        Command="{Binding KillCommand}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                        Background="#C03030" Foreground="White"
                                                        FontWeight="Bold" FontSize="13"
                                                        Padding="14,4" Margin="0,0,4,0"
                                                        BorderBrush="#801818" BorderThickness="1"
                                                        ToolTip="Block ALL controlled devices for up to 24h (router-wide override; clear to release sooner)"/>
                                                <Button Content="Allow 30m"
                                                        Command="{Binding Allow30mCommand}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                        Background="#339944" Foreground="White"
                                                        Padding="10,4" Margin="0,0,4,0"
                                                        BorderBrush="#1F6629" BorderThickness="1"
                                                        ToolTip="Allow ALL controlled devices online for 30 minutes (router-wide override)"/>
                                                <Button Content="Clear"
                                                        Command="{Binding ClearOverrideCommand}"
                                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                                        Background="#55555A" Foreground="White"
                                                        Padding="10,4"
                                                        BorderBrush="#33333A" BorderThickness="1"
                                                        ToolTip="Clear any active override and revert to the schedule"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Margin="4,0,0,2"
                                                       Text="{Binding LastActionText}"
                                                       Foreground="#FFC833"
                                                       FontSize="10"
                                                       FontStyle="Italic">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastActionText}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1" To="0" Duration="0:0:0.6"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             To="1" Duration="0:0:0.15"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last DHCP"  Binding="{Binding LastDhcp, StringFormat='yyyy-MM-dd HH:mm'}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PaneBg}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PaneHeaderBg}" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Schedule (block windows)" FontWeight="SemiBold"/>
                            <Border Grid.Column="1"
                                    Background="#553311"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Visibility="{Binding Schedule.HasPendingChanges, Converter={StaticResource BoolToVis}}">
                                <TextBlock>
                                    <Run Text="● "/>
                                    <Run Text="{Binding Schedule.PendingChangeCount, Mode=OneWay}"/>
                                    <Run Text=" pending"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="10,6"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Discard"
                                        Padding="14,4" Margin="0,0,8,0"
                                        Click="DiscardSchedule_Click"
                                        IsEnabled="{Binding Schedule.HasPendingChanges}"/>
                                <Button Content="Apply"
                                        Padding="14,4"
                                        Click="ApplySchedule_Click"
                                        IsEnabled="{Binding Schedule.HasPendingChanges}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Schedule.ApplyError}"
                                       Foreground="#FF8080"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <v:ScheduleTimeline x:Name="Timeline"
                                        EditedSchedule="{Binding Schedule.EditedSchedule}"
                                        OverrideActive="{Binding Schedule.OverrideActive}"
                                        Margin="6"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PaneBg}">
                <v:DomainsControl DataContext="{Binding Domains}"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PaneHeaderBg}" Padding="10,4"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource MutedText}"/>
        </Border>
    </Grid>
</Window>
