<UserControl x:Class="KidBlockUI.Views.BulkActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:KidBlockUI.Resources">
    <!-- DM9: bulk-action bar above the Devices DataGrid for the bedtime use case.
         Per-row buttons (KILL/Allow 30m/Clear) act per-MAC; these act over the
         full kidblock-macs.conf set in one shell call. -->
    <Border Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="0,0,0,1"
            Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Bulk:" FontWeight="SemiBold" Foreground="#AAAAAA"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>

            <Button Grid.Column="1"
                    Content="KILL ALL"
                    Command="{Binding BulkKillCommand}"
                    Background="#C03030" Foreground="White"
                    FontWeight="Bold" FontSize="13"
                    Padding="14,5" Margin="0,0,8,0"
                    BorderBrush="#801818" BorderThickness="1"
                    ToolTip="Block ALL controlled devices for up to 24h (confirm-gated, bedtime use case)"/>

            <Grid Grid.Column="2" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="ALLOW 30m ALL"
                        Command="{Binding BulkAllowCommand}"
                        Background="#339944" Foreground="White"
                        Padding="14,5"
                        BorderBrush="#1F6629" BorderThickness="1,1,0,1"
                        ToolTip="Allow ALL controlled devices online for 30 minutes (router-wide override)"/>
                <ToggleButton Grid.Column="1" x:Name="BulkAllowSplit"
                              Content="&#x25BC;"
                              Background="#2A7A38" Foreground="White"
                              FontSize="9" Padding="6,5"
                              BorderBrush="#1F6629" BorderThickness="0,1,1,1"
                              ToolTip="Pick an allow duration for ALL devices: 15m / 30m / 45m / 1-8h"/>
                <Popup PlacementTarget="{Binding ElementName=BulkAllowSplit}" Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=BulkAllowSplit, Mode=TwoWay}"
                       StaysOpen="False">
                    <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1">
                        <ItemsControl ItemsSource="{x:Static r:AllowDurations.Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            CommandParameter="{Binding Minutes}"
                                            Command="{Binding DataContext.BulkAllowDurationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            Click="AllowDurationItem_Click"
                                            Foreground="White"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Padding="14,5" MinWidth="130"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>

            <Button Grid.Column="3"
                    Content="CLEAR ALL"
                    Command="{Binding BulkClearCommand}"
                    Background="#55555A" Foreground="White"
                    Padding="14,5"
                    BorderBrush="#33333A" BorderThickness="1"
                    ToolTip="Clear all active per-MAC overrides; every device returns to the schedule"/>

            <TextBlock Grid.Column="5"
                       Text="{Binding OverridesSummary}"
                       Foreground="#FFC833"
                       FontStyle="Italic"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
