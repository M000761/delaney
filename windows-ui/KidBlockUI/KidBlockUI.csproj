<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- DM18 (DM13 program, Stage 4): enable WinForms so App can host a System.Windows.Forms
         NotifyIcon system-tray surface. The Forms assemblies ship in the same WindowsDesktop
         shared framework that UseWPF already references, so this adds NO NuGet package
         (offline-safe) and does NOT change the WPF entry point (App.xaml still owns Main). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>KidBlockUI</RootNamespace>
    <AssemblyName>KidBlockUI</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- DM18: WinForms is on ONLY for the App-hosted NotifyIcon. Drop its two implicit global
       usings so System.Windows.Forms / System.Drawing simple names (Application, Color, Point,
       ...) do NOT collide with the WPF System.Windows / System.Windows.Media names the rest of
       the code resolves unqualified; the tray code fully-qualifies the few Forms types it uses. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\domain-categories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Syncfusion WPF v33.2.13 substrate for the KidBlockUI Ribbon/dock-shell migration
       (DM13 program, Stage 0 / DM14; Community edition). Ribbon (Tools.WPF), SfDataGrid
       (SfGrid.WPF), SfSkinManager + the FluentDark theme, Licensing, Shared.WPF;
       Syncfusion.Data.WPF comes transitively. The v33 Community licence registers at
       startup from a NON-tracked source (the SYNCFUSION_LICENSE_KEY env var or the
       gitignored syncfusion-license.key); it is never hardcoded. Syncfusion HOSTS the
       existing bespoke controls, it does not replace them. -->
  <ItemGroup>
    <PackageReference Include="Syncfusion.Tools.WPF" Version="33.2.13" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="33.2.13" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="33.2.13" />
    <PackageReference Include="Syncfusion.Themes.FluentDark.WPF" Version="33.2.13" />
    <PackageReference Include="Syncfusion.Licensing" Version="33.2.13" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="33.2.13" />
  </ItemGroup>

  <!-- DM15 (DM13 program, Stage 1): palette lint gate. Fails the build on a new or
       grown inline Foreground/Background hex literal in Views/*.xaml; the sanctioned
       residue is frozen in palette-lint-allowlist.txt. Use Themes/Theme.xaml keys. -->
  <Import Project="PaletteLint.targets" />

</Project>
